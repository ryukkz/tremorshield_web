# Token required to hit /admin/* endpoints (list/download session zips).
# Change this to something random before deploying.
ADMIN_TOKEN=changeme

# Optional: fill these in to have each finished session auto-emailed to you
# as a zip attachment. Leave blank to skip email and just download from
# /admin/sessions instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_16_char_app_password
ADMIN_EMAIL=youraddress@gmail.com
