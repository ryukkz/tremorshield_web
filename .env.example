# Token required to use the /admin/* endpoints. Use a long random value.
ADMIN_TOKEN=change-this-to-a-random-secret

# Email settings. Gmail/Google Workspace: use an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_16_char_app_password
ADMIN_EMAIL=youraddress@gmail.com
